{
  "name": "cortex_os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev --hostname 0.0.0.0 --port 3000\" \"local-ssl-proxy --source 3443 --target 3000 --cert .cert/localhost+3.pem --key .cert/localhost+3-key.pem --hostname 0.0.0.0\"",
    "dev:http": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:local": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "concurrently \"prisma studio --port 5555 --browser none\" \"local-ssl-proxy --source 5556 --target 5555 --cert .cert/localhost+3.pem --key .cert/localhost+3-key.pem --hostname 0.0.0.0\"",
    "db:studio:http": "prisma studio --port 5555 --browser none",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:users": "node scripts/create-admin-users.js",
    "db:seed:test": "node scripts/run-seed-sql.js"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-neon": "^7.4.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.21",
    "@trpc/client": "^11.0.0",
    "@trpc/next": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "family-chart": "^0.9.0",
    "force-graph": "^1.51.1",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-cloudinary": "^6.17.5",
    "openai": "^6.22.0",
    "pg": "^8.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-family-tree": "^3.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-hook-form": "^7.71.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "local-ssl-proxy": "^2.0.5",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "ws": "^8.19.0"
  }
}
